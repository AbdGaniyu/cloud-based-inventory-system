DATABASE_URL="postgresql://gadgethub:gadgethub@localhost:5432/gadgethub?schema=public"
# Integration tests (pnpm test). Defaults to DATABASE_URL with a "_test" database name.
TEST_DATABASE_URL=
AUTH_SECRET=
APP_URL=http://localhost:3000
CRON_SECRET=
DOCUMENT_SIGNING_SECRET=
# Encrypts provider keys saved in Settings → Messaging (32 random bytes, base64: `openssl rand -base64 32`).
# Optional: derived from AUTH_SECRET when empty. Changing it makes saved keys unreadable (re-enter them).
SETTINGS_ENCRYPTION_KEY=

# Password for every seeded dev login (prisma/seed.ts). Defaults to GadgetHub!2026 when empty.
SEED_PASSWORD=
# The seed refuses to run in production or on a database with real (non-demo) users. Override only for a throwaway demo.
SEED_ALLOW_PRODUCTION=
SEED_ALLOW_REAL_DATA=

# Owners must set up two-factor sign-in (authenticator app) in production. true/false forces it on or off
# in any environment; leave empty for the default (on in production, optional in development).
REQUIRE_OWNER_2FA=

# Where the client IP for sign-in rate limiting comes from (anything the client could forge is ignored).
# On Vercel nothing is needed. Behind Cloudflare: CLIENT_IP_HEADER=cf-connecting-ip. Otherwise set how many
# reverse proxies append to X-Forwarded-For (default 1; 0 trusts no IP).
CLIENT_IP_HEADER=
TRUSTED_PROXY_COUNT=

WHATSAPP_PROVIDER=console          # whatsapp-cloud | twilio | console
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=
# Meta app secret: verifies X-Hub-Signature-256 on delivery webhooks.
WHATSAPP_CLOUD_APP_SECRET=
# Graph API version; defaults to v23.0.
WHATSAPP_CLOUD_API_VERSION=

SMS_PROVIDER=console               # termii | twilio | console
TERMII_API_KEY=
TERMII_SENDER_ID=
# Account base URL from the Termii dashboard; defaults to https://api.ng.termii.com.
TERMII_BASE_URL=
# generic (default) or dnd once Termii approves the sender ID for DND numbers.
TERMII_CHANNEL=
# Random string; set the Termii webhook to {APP_URL}/api/webhooks/termii?token=<this>.
TERMII_WEBHOOK_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Operations alerts to the people running the store (failing or late jobs, bursts of failed customer
# messages, unexpected server errors), at most once an hour per kind. Either or both:
# a Slack/Discord-compatible incoming webhook URL, and/or a phone number for an SMS (uses SMS_PROVIDER).
ALERT_WEBHOOK_URL=
ALERT_PHONE=
